  "promptText": {
    "original": {
      "language": "en",
      "value": "Colorize this comic page and translate it into Chinese, placing the text in the original positions while maintaining composition and image details consistently",
      "source": "upstream"
    },
    "translations": {
      "zh-CN": {
        "language": "zh-CN",
        "value": "给这页漫画上色，并把它翻译成中文。文字要放回原来的位置，同时保持构图和图像细节的一致性。",
        "source": "upstream"
      },
      "zh-TW": {
        "language": "zh-TW",
        "value": "替這頁漫畫上色，並翻譯成中文，把文字放回原本的位置，同時維持構圖與圖像細節的一致性。",
        "source": "upstream"
      },
      "ja": {
        "language": "ja",
        "value": "この漫画ページをカラー化し、中国語に翻訳して、元の位置にテキストを配置しながら、構図と画像ディテールの一貫性を保つ",
        "source": "upstream"
      },
      "ko": {
        "language": "ko",
        "value": "이 만화 페이지를 채색하고 중국어로 번역해, 원래 위치에 텍스트를 넣으면서 구성과 이미지 디테일의 일관성을 유지한다.",
        "source": "upstream"
      },
      "fr": {
        "language": "fr",
        "value": "Colorise cette page de bande dessinée et traduis-la en chinois, en remettant le texte à sa place d'origine tout en conservant la composition et les détails de l'image.",
        "source": "upstream"
      },
      "de": {
        "language": "de",
        "value": "Koloriere diese Comicseite und übersetze sie ins Chinesische, wobei der Text an die ursprünglichen Positionen gesetzt wird und Komposition sowie Bilddetails konsistent bleiben.",
        "source": "upstream"
      },
      "es": {
        "language": "es",
        "value": "Colorea esta página de cómic y tradúcela al chino, colocando el texto en las posiciones originales y manteniendo la composición y los detalles de la imagen.",
        "source": "upstream"
      }
    }
  },
