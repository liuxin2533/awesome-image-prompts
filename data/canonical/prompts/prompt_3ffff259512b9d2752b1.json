  "promptText": {
    "original": {
      "language": "en",
      "value": "A massive pile of rice, and on one single grain of rice there is tiny text that reads \"wOw\"",
      "source": "upstream"
    },
    "translations": {
      "zh-CN": {
        "language": "zh-CN",
        "value": "一大堆米，其中有一粒米上写着极小的文字“wOw”",
