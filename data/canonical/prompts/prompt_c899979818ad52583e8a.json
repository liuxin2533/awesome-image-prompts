  "promptText": {
    "original": {
      "language": "en",
      "value": "Generate an image of the authentic manuscript of [classic text title]\n\nGenerate an image of the authentic manuscript of [classic text title], and incorporate the emotional core of the work into the calligraphy",
      "source": "upstream"
    },
    "translations": {
      "zh-CN": {
        "language": "zh-CN",
        "value": "生成 [经典文本标题] 的真迹手稿图像\n\n生成 [经典文本标题] 的真迹手稿图像，并把作品的情感核心融入书法表达之中",
        "source": "upstream"
      },
      "zh-TW": {
        "language": "zh-TW",
        "value": "生成 [經典文本標題] 的真跡手稿圖像；或生成 [經典文本標題] 的真跡手稿圖像，並把作品的情感核心融入書法表達中。",
        "source": "upstream"
      },
      "ja": {
        "language": "ja",
        "value": "[classic text title] の真跡手稿画像を生成する\n\n[classic text title] の真跡手稿画像を生成し、その作品の感情的核心を書に取り込む",
        "source": "upstream"
      },
      "ko": {
        "language": "ko",
        "value": "[classic text title] 의 진적 원고 이미지를 생성한다. 또는 작품의 정서적 핵심을 서예 표현에 녹여 넣는다.",
        "source": "upstream"
      },
      "fr": {
        "language": "fr",
        "value": "Génère l'image du manuscrit authentique de [titre du texte classique], ou une version intégrant le cœur émotionnel de l'œuvre dans la calligraphie.",
        "source": "upstream"
      },
      "de": {
        "language": "de",
        "value": "Erzeuge ein Bild des authentischen Manuskripts von [Titel des klassischen Textes] oder eine Variante, die den emotionalen Kern des Werkes in die Kalligrafie integriert.",
        "source": "upstream"
      },
      "es": {
        "language": "es",
        "value": "Genera la imagen del manuscrito auténtico de [título del texto clásico], o una variante que incorpore el núcleo emocional de la obra en la caligrafía.",
        "source": "upstream"
      }
    }
  },
