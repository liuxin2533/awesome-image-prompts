  "promptText": {
    "original": {
      "language": "en",
      "value": "Generate image:\nTaobao product detail page of a T-800 robot, showing:\nfront, side, and back three-view drawings of the robot,\nproduct price,\nproduct details,\nfunctions and usage scenarios",
      "source": "upstream"
    },
    "translations": {
      "zh-CN": {
        "language": "zh-CN",
        "value": "生成图片：\n一个 T-800 机器人的淘宝商品详情页，展示：\n机器人的正面、侧面和背面三视图，\n商品价格，\n商品详情，\n功能与使用场景",
        "source": "upstream"
      },
      "zh-TW": {
        "language": "zh-TW",
        "value": "生成圖片：T-800 機器人的淘寶商品詳情頁，展示機器人的正面、側面與背面三視圖、商品價格、商品詳情，以及功能與使用情境。",
        "source": "upstream"
      },
      "ja": {
        "language": "ja",
        "value": "画像を生成:\nT-800 ロボットの淘宝商品詳細ページ。以下を表示する:\nロボットの正面・側面・背面の三面図\n商品価格\n商品詳細\n機能と利用シーン",
        "source": "upstream"
      },
      "ko": {
        "language": "ko",
        "value": "T-800 로봇의 타오바오 상품 상세 페이지 이미지를 생성한다. 정면/측면/후면 3면도, 가격, 상세 정보, 기능과 사용 시나리오를 포함한다.",
        "source": "upstream"
      },
      "fr": {
        "language": "fr",
        "value": "Génère une page produit Taobao pour un robot T-800 montrant vues avant / profil / arrière, prix, détails produit, fonctions et cas d'usage.",
        "source": "upstream"
      },
      "de": {
        "language": "de",
        "value": "Erzeuge eine Taobao-Produktdetailseite für einen T-800-Roboter mit Vorder-, Seiten- und Rückansicht, Preis, Produktdetails, Funktionen und Einsatzszenarien.",
        "source": "upstream"
      },
      "es": {
        "language": "es",
        "value": "Genera una página de detalle de producto de Taobao para un robot T-800, mostrando vistas frontal, lateral y trasera, precio, detalles del producto, funciones y escenarios de uso.",
        "source": "upstream"
      }
    }
