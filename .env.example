# AI translation provider (Zhipu AI)
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPUAI_MODEL=glm-4.5-flash

# OpenAI-compatible fallback names are also supported.
AI_TRANSLATION_API_KEY=
AI_TRANSLATION_BASE_URL=
AI_TRANSLATION_MODEL=

# Canonical and website languages
TARGET_LANGUAGES=en,zh-CN
CATALOG_LANGUAGES=en,zh-CN
DEFAULT_LANGUAGE=en

# Workflow toggles
ENABLE_TRANSLATION=false
TRANSLATION_LANGUAGES=zh-CN
TRANSLATION_DELAY_MS=300
TRANSLATION_RETRIES=3
TRANSLATION_RETRY_BASE_DELAY_MS=1000
MIRROR_ASSETS=false
